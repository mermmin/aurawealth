# Copy to .env (gitignored) and fill in. Spring Boot reads .env on startup; real env vars take precedence.

# Plaid sandbox keys: https://dashboard.plaid.com -> Team Settings -> Keys
PLAID_CLIENT_ID=
PLAID_SECRET=

# Optional: override the dev-only JWT signing secret (32+ random bytes, e.g. `openssl rand -base64 48`)
# JWT_SECRET=

# Optional: override the dev-only key that encrypts Plaid access tokens at rest (32 random bytes, base64: `openssl rand -base64 32`)
# TOKEN_ENCRYPTION_KEY=
